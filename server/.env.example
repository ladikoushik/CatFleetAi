PORT=5000
NODE_ENV=development

# Database Dialect: sqlite (zero-config out of the box) or mysql
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# MySQL Config (if DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cat_fleetbrain_db
DB_USER=root
DB_PASSWORD=password

# JWT Auth Secret
JWT_SECRET=cat_fleetbrain_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
